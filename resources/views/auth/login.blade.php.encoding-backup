<script>

(function () {

    'use strict';


    const form =
        document.getElementById('loginForm');

    const phone =
        document.getElementById('phone');

    const submit =
        document.getElementById('loginSubmit');

    const submitText =
        document.getElementById('submitText');

    const spinner =
        document.getElementById('submitSpinner');

    const errorBox =
        document.getElementById('loginError');

    const successBox =
        document.getElementById('loginSuccess');

    const accountStatus =
        document.getElementById('accountStatus');

    const passwordSection =
        document.getElementById('passwordSection');

    const rememberSection =
        document.getElementById('rememberSection');

    const password =
        document.getElementById('password');

    const passwordToggle =
        document.getElementById('passwordToggle');

    const eyeOpen =
        passwordToggle.querySelector('.eye-open');

    const eyeClosed =
        passwordToggle.querySelector('.eye-closed');


    let accountChecked = false;

    let accountExists = false;


    /*
     * طھط¨ط¯غŒظ„ ط§ط¹ط¯ط§ط¯ ظپط§ط±ط³غŒ ظˆ ط¹ط±ط¨غŒ ط¨ظ‡ ط§ظ†ع¯ظ„غŒط³غŒ
     */

    function toEnglishDigits(value) {

        return value
            .replace(
                /[غ°-غ¹]/g,
                function (digit) {

                    return String(
                        'غ°غ±غ²غ³غ´غµغ¶غ·غ¸غ¹'.indexOf(digit)
                    );

                }
            )
            .replace(
                /[ظ -ظ©]/g,
                function (digit) {

                    return String(
                        'ظ ظ،ظ¢ظ£ظ¤ظ¥ظ¦ظ§ظ¨ظ©'.indexOf(digit)
                    );

                }
            );

    }


    /*
     * ظ¾ط§ع©â€Œط³ط§ط²غŒ ط´ظ…ط§ط±ظ‡ ظ…ظˆط¨ط§غŒظ„
     */

    function cleanPhone(value) {

        value =
            toEnglishDigits(
                value || ''
            );

        return value
            .replace(/\D/g, '')
            .slice(0, 11);

    }


    /*
     * ط¨ط±ط±ط³غŒ ظ…ط¹طھط¨ط± ط¨ظˆط¯ظ† ط´ظ…ط§ط±ظ‡
     */

    function isValidPhone(value) {

        return /^09\d{9}$/.test(value);

    }


    /*
     * ظ¾ط§ع© ع©ط±ط¯ظ† ظ¾غŒط§ظ…â€Œظ‡ط§
     */

    function clearMessages() {

        errorBox.textContent = '';

        errorBox.style.display =
            'none';

        successBox.textContent = '';

        successBox.style.display =
            'none';

    }


    /*
     * ظ†ظ…ط§غŒط´ ظ¾غŒط§ظ… ط®ط·ط§غŒ ظپط§ط±ط³غŒ
     */

    function showError(message) {

        successBox.textContent = '';

        successBox.style.display =
            'none';

        errorBox.textContent =
            message ||
            'ط¯ط± ط­ط§ظ„ ط­ط§ط¶ط± ط§ظ…ع©ط§ظ† ط§ظ†ط¬ط§ظ… ط§غŒظ† ط¯ط±ط®ظˆط§ط³طھ ظˆط¬ظˆط¯ ظ†ط¯ط§ط±ط¯. ظ„ط·ظپط§ظ‹ ط¯ظˆط¨ط§ط±ظ‡ طھظ„ط§ط´ ع©ظ†غŒط¯.';

        errorBox.style.display =
            'block';

    }


    /*
     * ط¨ط§ط²ع¯ط±ط¯ط§ظ†ط¯ظ† ظپط±ظ… ط¨ظ‡ ط­ط§ظ„طھ ط§ظˆظ„غŒظ‡
     */

    function resetAccountState() {

        accountChecked = false;

        accountExists = false;

        accountStatus.textContent = '';

        accountStatus.style.display =
            'none';

        accountStatus.className =
            'account-status';

        passwordSection.style.display =
            'none';

        rememberSection.style.display =
            'none';

        password.value = '';

        password.required = false;

        submitText.textContent =
            'ط§ط¯ط§ظ…ظ‡';

    }


    /*
     * ظپط¹ط§ظ„ / ط؛غŒط±ظپط¹ط§ظ„ ع©ط±ط¯ظ† ط¯ع©ظ…ظ‡
     */

    function updateButton() {

        const value =
            cleanPhone(
                phone.value
            );

        const valid =
            isValidPhone(value);

        submit.disabled =
            !valid;

        submit.classList.toggle(
            'active',
            valid
        );

        submit.setAttribute(
            'aria-disabled',
            valid
                ? 'false'
                : 'true'
        );

    }


    /*
     * ظ†ظ…ط§غŒط´ ط­ط§ظ„طھ ط¹ط§ط¯غŒ ط¯ع©ظ…ظ‡
     */

    function restoreSubmitButton() {

        submit.disabled = false;

        submitText.style.display =
            'inline';

        spinner.style.display =
            'none';

        updateButton();

    }


    /*
     * ظ†ظ…ط§غŒط´ ط­ط§ظ„طھ ط¯ط± ط­ط§ظ„ ظ¾ط±ط¯ط§ط²ط´
     */

    function setLoading() {

        submit.disabled = true;

        submit.classList.remove(
            'active'
        );

        submitText.style.display =
            'none';

        spinner.style.display =
            'inline-block';

    }


    /*
     * طھط؛غŒغŒط± ط´ظ…ط§ط±ظ‡ ظ…ظˆط¨ط§غŒظ„
     */

    phone.addEventListener(
        'input',
        function () {

            const cleaned =
                cleanPhone(
                    phone.value
                );

            if (
                phone.value !== cleaned
            ) {

                phone.value =
                    cleaned;

            }

            clearMessages();

            resetAccountState();

            updateButton();

        }
    );


    /*
     * Paste
     */

    phone.addEventListener(
        'paste',
        function () {

            setTimeout(
                function () {

                    phone.value =
                        cleanPhone(
                            phone.value
                        );

                    clearMessages();

                    resetAccountState();

                    updateButton();

                },
                0
            );

        }
    );


    /*
     * ط¬ظ„ظˆع¯غŒط±غŒ ط§ط² ظˆط±ظˆط¯ ط­ط±ظˆظپ ظˆ ع©ط§ط±ط§ع©طھط±ظ‡ط§غŒ ط؛غŒط±ظ…ط¬ط§ط²
     */

    phone.addEventListener(
        'keydown',
        function (event) {

            const allowedKeys = [
                'Backspace',
                'Delete',
                'ArrowLeft',
                'ArrowRight',
                'Home',
                'End',
                'Tab'
            ];

            if (
                allowedKeys.includes(
                    event.key
                ) ||
                event.ctrlKey ||
                event.metaKey
            ) {

                return;

            }

            if (
                !/^\d$/.test(
                    event.key
                )
            ) {

                event.preventDefault();

            }

        }
    );


    /*
     * ظ†ظ…ط§غŒط´ / ظ…ط®ظپغŒ ع©ط±ط¯ظ† ط±ظ…ط²
     */

    passwordToggle.addEventListener(
        'click',
        function () {

            if (
                password.type ===
                'password'
            ) {

                password.type =
                    'text';

                eyeOpen.style.display =
                    'none';

                eyeClosed.style.display =
                    'block';

                passwordToggle.setAttribute(
                    'aria-label',
                    'ظ¾ظ†ظ‡ط§ظ† ع©ط±ط¯ظ† ط±ظ…ط² ط¹ط¨ظˆط±'
                );

                passwordToggle.setAttribute(
                    'title',
                    'ظ¾ظ†ظ‡ط§ظ† ع©ط±ط¯ظ† ط±ظ…ط² ط¹ط¨ظˆط±'
                );

            } else {

                password.type =
                    'password';

                eyeOpen.style.display =
                    'block';

                eyeClosed.style.display =
                    'none';

                passwordToggle.setAttribute(
                    'aria-label',
                    'ظ†ظ…ط§غŒط´ ط±ظ…ط² ط¹ط¨ظˆط±'
                );

                passwordToggle.setAttribute(
                    'title',
                    'ظ†ظ…ط§غŒط´ ط±ظ…ط² ط¹ط¨ظˆط±'
                );

            }

        }
    );


    /*
     * ط§ط±ط³ط§ظ„ ظپط±ظ…
     */

    form.addEventListener(
        'submit',
        async function (event) {

            event.preventDefault();

            clearMessages();


            const cleaned =
                cleanPhone(
                    phone.value
                );

            phone.value =
                cleaned;


            /*
             * ط§ط¹طھط¨ط§ط±ط³ظ†ط¬غŒ ط´ظ…ط§ط±ظ‡
             */

            if (
                !isValidPhone(cleaned)
            ) {

                showError(
                    'ظ„ط·ظپط§ظ‹ غŒع© ط´ظ…ط§ط±ظ‡ ظ…ظˆط¨ط§غŒظ„ ظ…ط¹طھط¨ط± غ±غ± ط±ظ‚ظ…غŒ ظˆط§ط±ط¯ ع©ظ†غŒط¯.'
                );

                updateButton();

                return;

            }


            /*
             * ط§ع¯ط± ظ‚ط¨ظ„ط§ظ‹ ظ…ط´ط®طµ ط´ط¯ظ‡ ع©ظ‡
             * ط­ط³ط§ط¨ ظˆط¬ظˆط¯ ط¯ط§ط±ط¯طŒ
             * ظˆط±ظˆط¯ ظ†ظ‡ط§غŒغŒ ط§ظ†ط¬ط§ظ… ظ…غŒâ€Œط´ظˆط¯.
             */

            if (
                accountChecked &&
                accountExists
            ) {

                if (
                    !password.value.trim()
                ) {

                    showError(
                        'ظ„ط·ظپط§ظ‹ ط±ظ…ط² ط¹ط¨ظˆط± ط®ظˆط¯ ط±ط§ ظˆط§ط±ط¯ ع©ظ†غŒط¯.'
                    );

                    password.focus();

                    return;

                }


                setLoading();


                /*
                 * ط§ط±ط³ط§ظ„ ط¹ط§ط¯غŒ ظپط±ظ… ظˆط±ظˆط¯
                 */

                form.submit();

                return;

            }


            /*
             * ظ…ط±ط­ظ„ظ‡ ط§ظˆظ„:
             * ط¨ط±ط±ط³غŒ ظˆط¬ظˆط¯ ط­ط³ط§ط¨
             */

            setLoading();


            accountStatus.textContent =
                'ط¯ط± ط­ط§ظ„ ط¨ط±ط±ط³غŒ ط´ظ…ط§ط±ظ‡...';

            accountStatus.className =
                'account-status checking';

            accountStatus.style.display =
                'block';


            try {

                /*
                 * ط¯ط±غŒط§ظپطھ CSRF Token
                 */

                const csrfInput =
                    document.querySelector(
                        'input[name="_token"]'
                    );


                if (!csrfInput) {

                    throw new Error(
                        'CSRF'
                    );

                }


                const csrfToken =
                    csrfInput.value;


                /*
                 * ط§ط±ط³ط§ظ„ ط´ظ…ط§ط±ظ‡ ط¨ظ‡ طµظˆط±طھ Form URL Encoded
                 */

                const requestBody =
                    new URLSearchParams();

                requestBody.append(
                    'phone',
                    cleaned
                );


                const response =
                    await fetch(
                        '{{ route('login.check.phone') }}',
                        {
                            method: 'POST',

                            headers: {

                                'Accept':
                                    'application/json',

                                'X-CSRF-TOKEN':
                                    csrfToken,

                                'X-Requested-With':
                                    'XMLHttpRequest',

                                'Content-Type':
                                    'application/x-www-form-urlencoded; charset=UTF-8'

                            },

                            credentials:
                                'same-origin',

                            body:
                                requestBody.toString()

                        }
                    );


                /*
                 * ظ¾ط§ط³ط® ط§ط¨طھط¯ط§ ط¨ظ‡ طµظˆط±طھ ظ…طھظ† ط®ظˆط§ظ†ط¯ظ‡ ظ…غŒâ€Œط´ظˆط¯.
                 */

                const rawText =
                    await response.text();


                /*
                 * ط­ط°ظپ BOM ط§ط­طھظ…ط§ظ„غŒ ط§ط² ط§ط¨طھط¯ط§غŒ ظ¾ط§ط³ط®
                 *
